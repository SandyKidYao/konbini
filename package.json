{
  "name": "konbini",
  "productName": "Konbini",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/icons.mjs",
    "pet": "npm run build && electron .",
    "pet:dev": "KONBINI_DEV_URL=http://localhost:5173/ electron .",
    "pet:pack": "npm run build && electron-builder --mac --publish never",
    "site": "npm run typecheck && vite build --outDir _site/app --emptyOutDir && cp -R site/. _site/ && cp assets/icon.svg _site/",
    "site:preview": "vite preview --outDir _site"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.62.1",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3"
  },
  "license": "MIT"
}
